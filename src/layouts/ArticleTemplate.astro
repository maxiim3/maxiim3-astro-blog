---
import type { CollectionEntry } from "astro:content";
import HeadMetadata from "../components/ui/head-metadata.astro";
import Footer from "../components/ui/footer.astro";
import DateFormatted from "../components/ui/date-formatted.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<article>
  <a href="/blog">Back</a>
  <div class="hero-image w-full">
    {
      heroImage && (
        <img
          width={1020}
          height={510}
          src={heroImage}
          alt=""
          class="mx-auto block rounded-xl"
        />
      )
    }
  </div>
  <div class="prose mx-auto w-[720px] max-w-[calc(100%-2em)] p-[1em]">
    <div class="title mb-[1em] px-0 py-[1em] text-center leading-none">
      <div class="date mb-[0.5em]">
        <DateFormatted date={pubDate} />
        {
          updatedDate && (
            <div class="last-updated-on italic">
              Last updated on <DateFormatted date={updatedDate} />
            </div>
          )
        }
      </div>
      <h1 class="mb-[0.5em]">{title}</h1>
      <hr />
    </div>
    <slot />
  </div>
</article>
