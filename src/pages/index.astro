---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import ReactButton from "../components/react-ui/react-button";
import SvelteButton from "../components/svelte-ui/svelte-button.svelte";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="grid grid-rows-[auto_1fr_auto] h-screen">
    <Header />
    <main class="self-start h-full text-center">
      <h1 class="text-accent">JavaScript et cetera</h1>
      <article class="space-y-2 text-pretty">
        <p>
          Welcome to <strong>JS etc.</strong> a blog where we discuss about JavaScript
          ecosystem.
        </p>
        <p>
          You will find article, research, experimentations with JavaScript and
          its framwework, such as <strong>React</strong>, <strong>Vue</strong> or
          <strong>Svelte</strong>.
        </p>
        <p>
          This blog is built with Astro, allowing us to include different
          frameworks.
        </p>
      </article>
    </main>
    <Footer />
  </body>
</html>
