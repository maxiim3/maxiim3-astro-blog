---
import AppLayout from "../../layouts/AppLayout.astro";
import { getCollection } from "astro:content";
import DateFormatted from "../../components/ui/date-formatted.astro";
import { SITE_TITLE } from "../../consts";

const today = new Date();

// Sort by date and filter by publication date is on or before today
const posts = (await getCollection("blog"))
  .filter((post) => post.data.pubDate.getTime() < today.getTime())
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<AppLayout title={`${SITE_TITLE} | Blog`}>
  <section>
    <ul>
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <img width={720} height={360} src={post.data.heroImage} alt="" />
              <h4 class="title">{post.data.title}</h4>
              <p class="date">
                <DateFormatted date={post.data.pubDate} />
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</AppLayout>
