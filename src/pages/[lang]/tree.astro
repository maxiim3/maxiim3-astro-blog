1.05 2.116c-.165 0-.3.135-.315.315l-.09 2.66.105 2.443c.015.18.135.315.3.315.164 0 .299-.135.314-.315l.12-2.443-.12-2.66c-.015-.18-.15-.315-.315-.315m.705-2.535c-.18 0-.315.15-.315.33l-.09 5.195.104 2.414c0 .18.136.33.316.33.165 0 .315-.15.315-.33l.105-2.414-.105-5.195c0-.18-.15-.33-.33-.33m1.095.645c0-.195-.15-.345-.345-.345-.18 0-.33.15-.345.345l-.075 4.55.09 2.399c.015.195.165.344.345.344.195 0 .345-.149.345-.344l.09-2.399-.09-4.55h-.015zm.75-1.5c-.195 0-.36.165-.36.36l-.074 6.05.089 2.384c0 .195.165.359.36.359.18 0 .36-.164.36-.359l.09-2.384-.09-6.05c0-.195-.18-.36-.375-.36m1.05 1.095c-.195 0-.375.18-.375.375l-.06 4.95.075 2.37c0 .21.165.375.375.375.195 0 .375-.165.375-.375l.075-2.37-.075-4.95c0-.195-.18-.375-.39-.375m.705-1.275c-.21 0-.375.18-.39.39l-.06 6.24.075 2.354c.015.21.18.375.39.375.195 0 .375-.165.375-.375l.09-2.354-.09-6.24c0-.21-.165-.39-.375-.39h-.015zm2.04 2.04c-.03-.24-.225-.42-.48-.42-.24 0-.435.18-.465.42l-.06 4.2.075 2.324c.03.255.225.435.465.435.255 0 .45-.18.48-.42l.075-2.34-.075-4.2h-.015z"/></svg>
