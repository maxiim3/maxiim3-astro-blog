              )}
              {link.icon === "dailydev" && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.901 0H5.099A5.1 5.1 0 000 5.099V18.9A5.1 5.1 0 005.099 24H18.9A5.1 5.1 0 0024 18.901V5.1A5.1 5.1 0 0018.901 0zm-8.9 16.875a4.875 4.875 0 110-9.75 4.875 4.875 0 010 9.75zm6 0a4.875 4.875 0 110-9.75 4.875 4.875 0 010 9.75z"/></svg>
              )}
              {link.name}
            </a>
          ))}
        </div>
      </section>

      <div class="divider"></div>

      <section>
        <h2 class="text-base-content/40 mb-3 text-sm font-semibold uppercase tracking-wider">
          {t("tree.personal")}
