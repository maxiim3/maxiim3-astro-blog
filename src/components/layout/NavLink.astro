---
interface Props {
  href: string;
  label: string;
  icon?: string;
  isActive?: boolean;
}

const { href, label, icon, isActive = false } = Astro.props;

// Determine if this link is active based on the current URL
const currentPath = Astro.url.pathname;
const active = isActive || currentPath === href || (href !== "/" && currentPath.startsWith(href));
---

<a
  href={href}
  class:list={[
    "flex items-center gap-3 rounded-lg px-4 py-3 transition-all duration-200",
    "hover:bg-base-200",
    active
      ? "bg-base-200 text-[#d4a04a] font-semibold"
      : "text-base-content hover:text-[#d4a04a]",
  ]}
>
  {icon && <span class="text-xl" aria-hidden="true">{icon}</span>}
  <span class="text-base">{label}</span>
</a>
